# Copy to .env.local and fill in. Never commit .env.local.

# From https://developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in the Spotify dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback/spotify

# Random secret used to encrypt the session cookie (32+ bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional: where the SQLite database lives (default: data/curator.db, git-ignored)
# DATABASE_PATH=data/curator.db
